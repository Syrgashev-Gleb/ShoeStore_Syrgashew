<Window x:Class="ShoeStore_Syrgashev.AddEditTovarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление/редактирование товара"
        Height="700" Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Times New Roman"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#7FFF00" Padding="20,15">
            <TextBlock x:Name="HeaderText"
                       Text="Управление товаром"
                       FontFamily="Times New Roman"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ID -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="ID товара:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1"
                         FontSize="14" Height="28" Padding="5,3"
                         IsReadOnly="True" Background="#F0F0F0"
                         Margin="0,8"/>

                <!-- Фото -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Фото товара:"
                           FontSize="14" VerticalAlignment="Top" Margin="0,8"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
                    <Border BorderBrush="#CCCCCC" BorderThickness="1"
                            Padding="4" Background="White" Margin="0,0,10,0">
                        <Image x:Name="PhotoTovarIm" Height="120" Width="180"
                               Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Button x:Name="SelectImageBtn"
                                Content="Выбрать изображение"
                                FontSize="13" Height="30" Padding="10,0"
                                Background="White" BorderBrush="Gray"
                                Cursor="Hand"
                                Click="SelectImageBtn_Click"/>
                        <TextBox x:Name="FileNameTB" FontSize="12"
                                 Height="24" Padding="4,2" Margin="0,6,0,0"
                                 IsReadOnly="True" Background="#F0F0F0"
                                 Width="200"/>
                    </StackPanel>
                </StackPanel>

                <!-- Наименование -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Наименование:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1"
                         FontSize="14" Height="28" Padding="5,3"
                         BorderBrush="Gray" BorderThickness="1"
                         Margin="0,8"/>

                <!-- Категория -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Категория:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <ComboBox x:Name="CategoryComboBox" Grid.Row="3" Grid.Column="1"
                          FontSize="14" Height="28" Padding="5,3"
                          BorderBrush="Gray" BorderThickness="1"
                          Margin="0,8"
                          SelectedValuePath="Category_ID"
                          DisplayMemberPath="Category"/>

                <!-- Описание -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Описание:"
                           FontSize="14" VerticalAlignment="Top" Margin="0,8"/>
                <TextBox x:Name="DescriptionTextBox" Grid.Row="4" Grid.Column="1"
                         FontSize="14" MinHeight="60" Padding="5,3"
                         BorderBrush="Gray" BorderThickness="1"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,8"/>

                <!-- Производитель -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Производитель:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <ComboBox x:Name="ManufacturerComboBox" Grid.Row="5" Grid.Column="1"
                          FontSize="14" Height="28" Padding="5,3"
                          BorderBrush="Gray" BorderThickness="1"
                          Margin="0,8"
                          SelectedValuePath="Manufacturer_ID"
                          DisplayMemberPath="Name"/>

                <!-- Поставщик -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Поставщик:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <ComboBox x:Name="SupplierComboBox" Grid.Row="6" Grid.Column="1"
                          FontSize="14" Height="28" Padding="5,3"
                          BorderBrush="Gray" BorderThickness="1"
                          Margin="0,8"
                          SelectedValuePath="Supplier_ID"
                          DisplayMemberPath="Supplier"/>

                <!-- Цена -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Цена:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="PriceTextBox" Grid.Row="7" Grid.Column="1"
                         FontSize="14" Height="28" Padding="5,3"
                         BorderBrush="Gray" BorderThickness="1"
                         PreviewTextInput="PriceTextBox_PreviewTextInput"
                         Margin="0,8"/>

                <!-- Единица измерения -->
                <TextBlock Grid.Row="8" Grid.Column="0" Text="Единица измерения:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="UnitTextBox" Grid.Row="8" Grid.Column="1"
                         FontSize="14" Height="28" Padding="5,3"
                         BorderBrush="Gray" BorderThickness="1"
                         Margin="0,8"/>

                <!-- Количество -->
                <TextBlock Grid.Row="9" Grid.Column="0" Text="Количество на складе:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="QuantityTextBox" Grid.Row="9" Grid.Column="1"
                         FontSize="14" Height="28" Padding="5,3"
                         BorderBrush="Gray" BorderThickness="1"
                         PreviewTextInput="QuantityTextBox_PreviewTextInput"
                         Margin="0,8"/>

                <!-- Скидка -->
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Действующая скидка:"
                           FontSize="14" VerticalAlignment="Center" Margin="0,8"/>
                <TextBox x:Name="DiscountTextBox" Grid.Row="10" Grid.Column="1"
                         FontSize="14" Height="28" Padding="5,3"
                         BorderBrush="Gray" BorderThickness="1"
                         PreviewTextInput="DiscountTextBox_PreviewTextInput"
                         Margin="0,8"/>
            </Grid>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,15,0,20">
            <Button x:Name="SaveBtn" Content="Сохранить"
                    FontSize="15" Height="38" Width="180"
                    Background="#00FA9A" BorderBrush="Gray"
                    BorderThickness="1" Cursor="Hand"
                    Click="SaveBtn_Click"/>

            <Button x:Name="DeleteBtn" Content="Удалить товар"
                    FontSize="15" Height="38" Width="180"
                    Margin="15,0,0,0"
                    Background="#FF6B6B" Foreground="White"
                    BorderBrush="#CC0000" BorderThickness="1"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="DeleteBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>