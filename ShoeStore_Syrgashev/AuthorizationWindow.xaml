<Window x:Class="ShoeStore_Syrgashev.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Обувь - Авторизация"
        Height="420" Width="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Times New Roman"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Зелёная шапка с логотипом ================= -->
        <Border Grid.Row="0"
                Background="#7FFF00"
                CornerRadius="10"
                Margin="20,15,20,0"
                Height="90">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип (не искажать пропорции!) -->
                <Image Grid.Column="1"
                       Source="Resources/Icon.png"
                       Height="70"
                       Margin="-250,0,0,0"
                       Stretch="Uniform"/>

                <!-- Заголовок по центру -->
                <TextBlock Grid.Column="1"
                           Text="Авторизация"
                           FontFamily="Times New Roman"
                           FontSize="26"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= Форма авторизации ================= -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Width="280"
                    Margin="0,40,0,0">

            <!-- Логин -->
            <TextBlock Text="Логин"
                       FontFamily="Times New Roman"
                       FontSize="14"
                       Margin="0,0,0,3"/>
            <TextBox x:Name="TbLogin"
                     Height="26"
                     FontFamily="Times New Roman"
                     FontSize="14"
                     Padding="3,2"/>

            <!-- Пароль -->
            <TextBlock Text="Пароль"
                       FontFamily="Times New Roman"
                       FontSize="14"
                       Margin="0,15,0,3"/>
            <PasswordBox x:Name="PbPassword"
                         Height="26"
                         FontFamily="Times New Roman"
                         FontSize="14"
                         Padding="3,2"/>

            <!-- Кнопка Войти -->
            <Button x:Name="BtnLogin"
                    Content="Войти"
                    Height="30"
                    Margin="0,25,0,0"
                    FontFamily="Times New Roman"
                    FontSize="14"
                    Background="#D3D3D3"
                    BorderBrush="Gray"
                    Cursor="Hand"
                    Click="BtnLogin_Click"/>

            <!-- Кнопка Войти как гость -->
            <Button x:Name="BtnGuest"
                    Content="Войти как гость"
                    Height="26"
                    Margin="0,12,0,0"
                    Padding="10,0"
                    HorizontalAlignment="Center"
                    FontFamily="Times New Roman"
                    FontSize="13"
                    Background="#D3D3D3"
                    BorderBrush="Gray"
                    Cursor="Hand"
                    Click="BtnGuest_Click"/>
        </StackPanel>
    </Grid>
</Window>