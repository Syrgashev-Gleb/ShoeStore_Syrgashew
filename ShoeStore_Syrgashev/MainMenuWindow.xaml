<Window x:Class="ShoeStore_Syrgashev.MainMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Обувь - Список товаров"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- Панель фильтров -->
            <RowDefinition Height="*"/>
            <!-- Список товаров -->
        </Grid.RowDefinitions>

        <!-- ================= Шапка ================= -->
        <Border Grid.Row="0"
        Background="#7FFF00"
        CornerRadius="10"
        Height="70"
        Margin="10,10,10,0">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопки администратора и менеджера -->
                <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button x:Name="BtnLogout"
                    Content="Выйти из системы"
                    Padding="10,5"
                    FontFamily="Times New Roman"
                    FontSize="13"
                    Background="White"
                    BorderBrush="Black"
                    Cursor="Hand"
                    Click="BtnLogout_Click"/>

                    <Button x:Name="BtnAddTovar"
                    Content="Добавить товар"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    FontFamily="Times New Roman"
                    FontSize="13"
                    Background="#00FA9A"
                    BorderBrush="Black"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="BtnAddTovar_Click"/>

                    <Button x:Name="BtnDeleteTovar"
                    Content="Удалить товар"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    FontFamily="Times New Roman"
                    FontSize="13"
                    Background="#FF6B6B"
                    Foreground="White"
                    BorderBrush="#CC0000"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="BtnDeleteTovar_Click"/>

                    <!-- ↓↓↓ НОВАЯ КНОПКА ↓↓↓ -->
                    <Button x:Name="BtnOrders"
                    Content="Заказы"
                    Margin="10,0,0,0"
                    Padding="10,5"
                    FontFamily="Times New Roman"
                    FontSize="13"
                    Background="White"
                    BorderBrush="Black"
                    Cursor="Hand"
                    Visibility="Collapsed"
                    Click="BtnOrders_Click"/>
                </StackPanel>

                <!-- Логотип + название -->
                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                    <Image Source="Resources/Icon.png"
                   Height="50"
                   Stretch="Uniform"/>
                    <TextBlock Text="ООО Обувь"
                       FontFamily="Times New Roman"
                       FontSize="22"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"/>
                </StackPanel>

                <!-- ФИО / роль -->
                <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">
                    <TextBlock x:Name="UserInfoTextBlock"
                       FontFamily="Times New Roman"
                       FontSize="14"
                       FontWeight="Bold"
                       HorizontalAlignment="Right"/>
                    <TextBlock x:Name="RoleInfoTextBlock"
                       FontFamily="Times New Roman"
                       FontSize="12"
                       Foreground="#333333"
                       HorizontalAlignment="Right"
                       Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Панель фильтров ================= -->
        <Border Grid.Row="1"
                Background="#7FFF00"
                CornerRadius="10"
                Margin="10,5,10,0"
                Padding="15,10"
                x:Name="FilterPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Поиск:" FontFamily="Times New Roman" FontSize="13"/>
                    <TextBox x:Name="TbSearch"
                             Height="26"
                             FontFamily="Times New Roman"
                             FontSize="13"
                             Padding="3,2"
                             TextChanged="TbSearch_TextChanged"/>
                </StackPanel>

                <!-- Сортировка -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Сортировка (по кол-ву на складе):"
                               FontFamily="Times New Roman" FontSize="13"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnSortAsc"
                                Content="По возрастанию"
                                Width="130"
                                Height="26"
                                FontFamily="Times New Roman"
                                FontSize="13"
                                Background="White"
                                BorderBrush="Black"
                                Cursor="Hand"
                                Click="BtnSortAsc_Click"/>
                        <Button x:Name="BtnSortDesc"
                                Content="По убыванию"
                                Width="110"
                                Height="26"
                                Margin="5,0,0,0"
                                FontFamily="Times New Roman"
                                FontSize="13"
                                Background="White"
                                BorderBrush="Black"
                                Cursor="Hand"
                                Click="BtnSortDesc_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Фильтр по поставщику -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Поставщик:"
                               FontFamily="Times New Roman" FontSize="13"/>
                    <ComboBox x:Name="CmbSupplier"
                              Height="26"
                              FontFamily="Times New Roman"
                              FontSize="13"
                              DisplayMemberPath="Supplier"
                              SelectedValuePath="Supplier_ID"
                              SelectionChanged="CmbSupplier_SelectionChanged"/>
                </StackPanel>

                <!-- Сброс -->
                <Button Grid.Column="3"
                        x:Name="BtnResetFilters"
                        Content="Сбросить фильтры"
                        Height="26"
                        VerticalAlignment="Bottom"
                        Padding="10,0"
                        FontFamily="Times New Roman"
                        FontSize="13"
                        Background="White"
                        BorderBrush="Black"
                        Cursor="Hand"
                        Click="BtnResetFilters_Click"/>
            </Grid>
        </Border>

        <!-- ================= Список товаров ================= -->
        <ListView Grid.Row="2"
                  x:Name="ListTovar"
                  Margin="10"
                  BorderBrush="#7FFF00"
                  BorderThickness="2"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_discount}" Value="True">
                            <Setter Property="Background" Value="#2E8B57"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding is_quantity}" Value="True">
                            <Setter Property="Background" Value="Cyan"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2"
                            Margin="5"
                            BorderBrush="Black"
                            Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    BorderThickness="2"
                                    Margin="5"
                                    BorderBrush="Black">
                                <Image Source="{Binding PhotoPath}"
                                       Margin="10"
                                       Width="120"
                                       Stretch="Uniform"/>
                            </Border>

                            <Border Grid.Column="1"
                                    BorderThickness="1"
                                    BorderBrush="Black"
                                    Margin="5">
                                <StackPanel Margin="5" Orientation="Vertical">

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Categories.Category}" FontWeight="Bold"/>
                                        <TextBlock Text=" | " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Описание товара: "/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Производитель: "/>
                                        <TextBlock Text="{Binding Manufacturers.Name}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Поставщик: "/>
                                        <TextBlock Text="{Binding Suppliers.Supplier}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Единица измерения: "/>
                                        <TextBlock Text="{Binding Unit}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Количество на складе: "/>
                                        <TextBlock Text="{Binding Stock_Quantity}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: "/>
                                        <TextBlock Text="{Binding Price, StringFormat={}{0:F2}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="5,0,0,0"
                                                   FontWeight="Bold"
                                                   Text="{Binding price_discount, StringFormat=Новая цена: {0:F2} руб.}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    BorderThickness="1"
                                    BorderBrush="Black"
                                    Margin="5">
                                <StackPanel Margin="5" VerticalAlignment="Center">
                                    <TextBlock Text="Скидка:" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Discount, StringFormat={}{0}%}"
                                               FontWeight="Bold"
                                               FontSize="16"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>