<Window x:Class="ShoeStore_Syrgashev.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ООО Обувь - Заказы"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman"
        Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна -->
        <Border Grid.Row="0" Background="#7FFF00"
                CornerRadius="10" Height="60" Margin="10,10,10,0">
            <Grid Margin="15,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnAddOrder"
                            Content="Добавить заказ"
                            Padding="10,5"
                            FontFamily="Times New Roman"
                            FontSize="13"
                            Background="#00FA9A"
                            BorderBrush="Black"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="BtnAddOrder_Click"/>

                    <Button x:Name="BtnDeleteOrder"
                            Content="Удалить заказ"
                            Margin="10,0,0,0"
                            Padding="10,5"
                            FontFamily="Times New Roman"
                            FontSize="13"
                            Background="#FF6B6B"
                            Foreground="White"
                            BorderBrush="#CC0000"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="BtnDeleteOrder_Click"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Список заказов"
                           FontFamily="Times New Roman"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           x:Name="TbUserInfo"
                           FontFamily="Times New Roman"
                           FontSize="13"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Список заказов -->
        <ListView Grid.Row="1"
                  x:Name="ListOrders"
                  Margin="10"
                  BorderBrush="#7FFF00"
                  BorderThickness="2"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="ListOrders_MouseDoubleClick"
                  PreviewKeyDown="ListOrders_PreviewKeyDown">

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2"
                            Margin="5"
                            BorderBrush="Black"
                            Background="White">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая часть -->
                            <Border Grid.Column="0"
                                    BorderThickness="1"
                                    BorderBrush="Black"
                                    Margin="5">
                                <StackPanel Margin="8" Orientation="Vertical">

                                    <!-- Артикул товара + наименование -->
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Артикул заказа: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ArticleDisplay}"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="  |  " Foreground="#888888"/>
                                        <TextBlock Text="{Binding NameDisplay}"
                                                   FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Статус заказа: "/>
                                        <TextBlock Text="{Binding Statuses.Status}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Адрес пункта выдачи: "/>
                                        <TextBlock Text="{Binding PickupPoints.City}"/>
                                        <TextBlock Text=", "/>
                                        <TextBlock Text="{Binding PickupPoints.Street}"/>
                                        <TextBlock Text=", д. "/>
                                        <TextBlock Text="{Binding PickupPoints.House}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Дата заказа: "/>
                                        <TextBlock Text="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>

                            <!-- Правая часть -->
                            <Border Grid.Column="1"
                                    BorderThickness="1"
                                    BorderBrush="Black"
                                    Margin="5">
                                <StackPanel Margin="8" VerticalAlignment="Center">
                                    <TextBlock Text="Дата доставки:"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}"
                                               HorizontalAlignment="Center"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>